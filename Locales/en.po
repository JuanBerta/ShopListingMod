# English translations for Shop Listing (3.2.6: completed base + dynamic message templates).
# msgid is the source string; dynamic strings are recorded as templates for future localization.

msgid "Mods"
msgstr "Mods"

msgid "Shows the commands available from the Shop Listing mod"
msgstr "Shows the commands available from the Shop Listing mod"

msgid "Adds an item to your shopping list. Usage: /sl add <item> <amount> [targetPrice]"
msgstr "Adds an item to your shopping list. Usage: /sl add <item> <amount> [targetPrice]"

msgid "Lists your shopping list and shows in real time where each item is sold, at what price and how far away. Usage: /sl list"
msgstr "Lists your shopping list and shows in real time where each item is sold, at what price and how far away. Usage: /sl list"

msgid "Removes an item from your shopping list by item name or list index (1-based). Usage: /sl remove <item|index>"
msgstr "Removes an item from your shopping list by item name or list index (1-based). Usage: /sl remove <item|index>"

msgid "Clears your shopping list. Usage: /sl clear [--yes]"
msgstr "Clears your shopping list. Usage: /sl clear [--yes]"

msgid "Shows this help. Usage: /sl help"
msgstr "Shows this help. Usage: /sl help"

msgid "Please provide a positive amount (e.g. /sl add Iron Bar 20)."
msgstr "Please provide a positive amount (e.g. /sl add Iron Bar 20)."

msgid "The target price must be a positive number, or omit it to disable price alerts."
msgstr "The target price must be a positive number, or omit it to disable price alerts."

msgid "There is nothing on your shopping list yet. Add items with /sl add <item> <amount>."
msgstr "There is nothing on your shopping list yet. Add items with /sl add <item> <amount>."

msgid "Your shopping list is empty after clearing."
msgstr "Your shopping list is empty after clearing."

msgid "Your shopping list is already empty."
msgstr "Your shopping list is already empty."

msgid "That index is out of range."
msgstr "That index is out of range."

msgid "Entry"
msgstr "Entry"

msgid "Your shopping list:"
msgstr "Your shopping list:"

msgid "Estimated total:"
msgstr "Estimated total:"

msgid "Run /sl add <item> <amount> to add more items."
msgstr "Run /sl add <item> <amount> to add more items."

msgid "Welcome to the Shop Listing mod! Keep track of the items you want to buy and find in real time which stores sell them."
msgstr "Welcome to the Shop Listing mod! Keep track of the items you want to buy and find in real time which stores sell them."

msgid "- /sl add <item> <amount> [targetPrice] — add an item and see all current sellers (price, stock, distance); set targetPrice to get a proactive alert when someone sells below it"
msgstr "- /sl add <item> <amount> [targetPrice] — add an item and see all current sellers (price, stock, distance); set targetPrice to get a proactive alert when someone sells below it"

msgid "- /sl list — show the list with the best current deal per item and an estimated total"
msgstr "- /sl list — show the list with the best current deal per item and an estimated total"

msgid "- /sl remove <item|index> — remove an entry by name or 1-based index"
msgstr "- /sl remove <item|index> — remove an entry by name or 1-based index"

msgid "- /sl clear --yes — empty your list (requires --yes to confirm)"
msgstr "- /sl clear --yes — empty your list (requires --yes to confirm)"

msgid "- /sl help — show this help"
msgstr "- /sl help — show this help"

msgid "N/A"
msgstr "N/A"

